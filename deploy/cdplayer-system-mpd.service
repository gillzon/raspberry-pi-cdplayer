[Unit]
Description=Automatic CD player using the system MPD instance
Wants=mpd.service
After=mpd.service

[Service]
Type=simple
User=cdplayer
Group=cdplayer
SupplementaryGroups=cdrom audio
CacheDirectory=cdplayer
Environment=XDG_CACHE_HOME=/var/cache
EnvironmentFile=-/etc/cdplayer/spotify.conf
ExecStart=/usr/local/bin/cdplayer -device auto -mpd 127.0.0.1:6600 -mpd-auto-device -cd-speed 4
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
# librespot needs temporary files even when audio caching is disabled.
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
