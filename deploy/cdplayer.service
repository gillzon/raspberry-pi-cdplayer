[Unit]
Description=Automatic audio CD player
Wants=cdplayer-mpd.service
After=cdplayer-mpd.service

[Service]
Type=simple
User=cdplayer
Group=cdplayer
SupplementaryGroups=cdrom audio
CacheDirectory=cdplayer
Environment=XDG_CACHE_HOME=/var/cache
EnvironmentFile=-/etc/cdplayer/spotify.conf
EnvironmentFile=-/etc/cdplayer/music.conf
ExecStart=/usr/local/bin/cdplayer -device auto -mpd 127.0.0.1:6601
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
# librespot needs temporary files even when audio caching is disabled.
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
